plugin.tx_saalevent {
    view {
        templateRootPaths {
            10 = EXT:saalevent/Resources/Private/Templates/
        }
        partialRootPaths {
            10 = EXT:saalevent/Resources/Private/Partials/
        }
        layoutRootPaths {
            10 = EXT:saalevent/Resources/Private/Layouts/
        }
    }
    settings {
        icsUrlSaal1 = {$saalevent.icsUrlSaal1}
        icsUrlSaal2 = {$saalevent.icsUrlSaal2}
        icsUrlSaal3 = {$saalevent.icsUrlSaal3}
        enableCache = 0
    }
}

page.includeCSS {
  saalevent = EXT:saalevent/Resources/Public/Css/custom.css
}